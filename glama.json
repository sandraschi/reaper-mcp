{
  "$schema": "https://glama.ai/mcp/schemas/server.json",
  "maintainers": ["sandraschi"],
  "name": "reaper-mcp",
  "description": "FastMCP server for DAW automation via Reaper with OSC control. 6 portmanteau tools consolidating transport, tracks, projects, system, reascript, and orchestrator operations.",
  "type": "mcp_server",
  "status": "active",
  "framework": "FastMCP >=3.4.2",
  "tools": 6,
  "transport": ["stdio", "http"],
  "keywords": [
    "reaper",
    "daw",
    "audio",
    "music-production",
    "osc",
    "automation",
    "mcp-server",
    "fastmcp"
  ],
  "features": {
    "transport_control": {"enabled": true, "operations": ["play", "stop", "pause", "record", "position"]},
    "track_management": {"enabled": true},
    "project_operations": {"enabled": true, "features": ["save", "markers", "render", "stats"]},
    "reascript_execution": {"enabled": true},
    "orchestrator": {"enabled": true},
    "osc_control": {"enabled": true}
  }
}
